{
  "name": "nexus-xo",
  "private": true,
  "version": "1.0.0",
  "description": "NEXUS XO — a polished human vs computer tic-tac-toe game with three algorithmic difficulty levels.",
  "license": "MIT",
  "author": "Surya Kishor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suryakishor/Nexus-XO.git"
  },
  "homepage": "https://github.com/suryakishor/Nexus-XO#readme",
  "bugs": {
    "url": "https://github.com/suryakishor/Nexus-XO/issues"
  },
  "keywords": [
    "tic-tac-toe",
    "minimax",
    "react",
    "typescript",
    "vite",
    "tailwindcss",
    "game-ai"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
